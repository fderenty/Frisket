<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes the native library for win-x64.

  Read by Visual Studio's Publish dialog and by the command line alike:

      dotnet publish bindings/native/Frisket.Native.csproj -p:PublishProfile=win-x64

  which is the whole point of the file. The runtime identifier and the output
  directory used to live only in build.ps1, so publishing from the IDE meant typing
  them into a dialog again - two places saying the same thing, with nothing to notice
  when they stopped agreeing.

  The script keeps what a profile cannot say: which toolchain to find, and whether
  what came out is actually there. Those are knowledge, not settings.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Stated rather than inferred. Left to itself the directory moves with the
         Platform property - bind\Release\... under one invocation and
         bin\Release\... under another - which is why the script used to look in two
         places and hope. -->
    <PublishDir>bin\win-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
