          { "$type": "TextItem", "Text": "Référence" },
          { "$type": "TextItem", "Text": "Montant ({Devise})" } ] },
        { "$type": "TableRow", "Childs": [
          { "$type": "TextItem", "Text": "{Ref}" },
          { "$type": "TextItem", "Text": "{Prix} {Devise}" } ] } ] }
    ] }]
  }]
