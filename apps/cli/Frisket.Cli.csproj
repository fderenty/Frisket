<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Frisket.Cli</RootNamespace>
    <!-- Not "frisket": Windows matches file names without regard to case, so an
         frisket.exe sitting beside Frisket.dll makes the project reference
         ambiguous and restore refuses it. -->
    <AssemblyName>Frisket.Cli</AssemblyName>
    <!-- Shipped as native binaries on a release, not as a package: a library package of an
         executable is nothing anybody can use, and a dotnet tool was weighed and declined
         on 18 October 2026 - it would need a .NET SDK on a machine the AOT binary does not. -->
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The engine is AOT-clean and this is the front door to it: publishing a
         single native executable per platform is the point of keeping it so. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\Frisket.csproj" />

    <!-- The PDF reader. Referenced here because this is the thing with a file system,
         and never by the engine: a document that imports nothing carries no parser. -->
    <ProjectReference Include="..\..\import\Frisket.Import.csproj" />
  </ItemGroup>

</Project>
